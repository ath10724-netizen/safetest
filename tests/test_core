def test_session_state_save_load_and_delete(temp_db):
    sid = db.create_session("exam")
    db.save_session_state(sid, '{"x": 1}')
    assert db.load_unfinished_state() == (sid, '{"x": 1}')
    db.finish_session(sid, 0, 0, 0.0, False)
    assert db.load_unfinished_state() is None  # 종료되면 복원 대상이 아니다
    sid2 = db.create_session("practice")
    db.delete_session(sid2)
    assert sid2 not in db.unfinished_session_ids()


def test_init_db_migrates_old_schema(tmp_path, monkeypatch):
    import sqlite3
    path = tmp_path / "old.db"
    with sqlite3.connect(path) as conn:
        conn.execute("CREATE TABLE sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, mode TEXT NOT NULL, started_at TEXT NOT NULL,"
                     " finished_at TEXT, total INTEGER, correct INTEGER, average REAL, passed INTEGER)")
    monkeypatch.setattr(db, "DB_PATH", path)
    db.init_db()
    sid = db.create_session("practice")
    db.save_session_state(sid, "{}")
    assert db.load_unfinished_state() == (sid, "{}")


def test_close_unfinished_sessions(temp_db):
    from ui import session
    q = qb.get_question("S1-R1-01")
    empty = db.create_session("exam")
    with_record = db.create_session("practice")
    db.record_attempt(with_record, q, q["answer"], True, 5)
    session.close_unfinished_sessions()
    assert db.unfinished_session_ids() == []
    finished = {s["id"]: s for s in db.fetch_sessions()}
    assert empty not in finished and finished[with_record]["correct"] == 1


def test_elapsed_is_capped():
    """B9: 자리를 비운 시간이 소요 시간을 왜곡하지 않도록 상한을 둔다."""
    from ui import session
    assert session.capped_elapsed(42.0) == 42.0
    assert session.capped_elapsed(3600.0) == session.MAX_ELAPSED_SEC
    assert session.capped_elapsed(-1.0) == 0.0
