# ---------------------------------------------------------------- 분석·추천

def test_weak_unit_detection_uses_recency():
    q = qb.get_question("S3-R1-02")  # 양중기
    other = qb.get_question("S2-R1-01")
    attempts = [_attempt(q, True), _attempt(q, False), _attempt(q, False), _attempt(other, True), _attempt(other, True)]
    stats = analyzer.unit_stats(attempts)
    top = stats.iloc[0]
    assert top["unit"] == "양중기" and top["is_weak"]
    assert "연속 오답" in top["diagnosis"]
    assert not stats[stats["unit"] == other["unit"]]["is_weak"].any()


def test_recommend_prioritizes_wrong_and_weak_units():
    questions = list(qb.load_questions())
    q = qb.get_question("S3-R1-02")
    attempts = [_attempt(q, False), _attempt(q, False), _attempt(q, False)]
    recs = analyzer.recommend(attempts, questions, size=10, seed=0)
    ids = [r[0]["id"] for r in recs]
    assert len(ids) == 10 and len(set(ids)) == 10
    assert ids[0] == q["id"]
    assert any(r[0]["unit"] == "양중기" and "취약 단원" in r[1] for r in recs[1:])


def test_recommend_without_history():
    recs = analyzer.recommend([], list(qb.load_questions()), size=5, seed=1)
    assert len(recs) == 5


# ---------------------------------------------------------------- DB

def test_db_roundtrip(temp_db):
    q = qb.get_question("S1-R1-01")
    sid = db.create_session("practice")
    db.record_attempt(sid, q, 1, False, 12.3)
    db.finish_session(sid, 1, 0, 0.0, False)
    attempts = db.fetch_attempts()
    assert attempts[0]["question_id"] == q["id"] and attempts[0]["is_correct"] == 0
    assert db.fetch_sessions()[0]["total"] == 1

    db.save_explanation(q["id"], 1, "해설", "claude-opus-5-5")
    assert db.get_explanation(q["id"], 1) == "해설"
    db.reset_history()
    assert db.fetch_attempts() == []
    assert db.get_explanation(q["id"], 1) == "해설"


# ---------------------------------------------------------------- 분석용 기록 거르기 (미응답·지워진 문제)

def test_usable_attempts_excludes_unanswered_and_unknown():
    questions = list(qb.load_questions())
    q = qb.get_question("S1-R1-01")
    attempts = [
        {**_attempt(q, False), "chosen": None},  # 모의고사 미응답
        {**_attempt(q, False), "question_id": "DELETED-01"},  # 지워진 문제
        _attempt(q, True),
    ]
    usable = analyzer.usable_attempts(attempts, questions)
    assert len(usable) == 1 and usable[0]["question_id"] == q["id"]


def test_answer_positions_are_balanced():
    counts = [sum(q["answer"] == n for q in qb.load_questions()) for n in range(1, 5)]
    assert max(counts) - min(counts) <= 4, counts


