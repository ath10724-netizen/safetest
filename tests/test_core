import pytest

from core import analyzer, db, grader, law_search
from core import question_bank as qb
from core.config import SUBJECTS


@pytest.fixture
def temp_db(tmp_path, monkeypatch):
    monkeypatch.setattr(db, "DB_PATH", tmp_path / "test.db")
    db.init_db()


def _attempt(q, correct):
    return {"question_id": q["id"], "subject": q["subject"], "unit": q["unit"], "is_correct": int(correct), "chosen": 1}


# ---------------------------------------------------------------- 데이터 무결성

def test_questions_are_valid():
    questions = qb.load_questions()
    ids = [q["id"] for q in questions]
    assert len(ids) == len(set(ids))
    law_ids = {law["id"] for law in law_search.load_laws()}
    for q in questions:
        assert q["subject"] in SUBJECTS
        assert 1 <= q["answer"] <= len(q["choices"])
        assert q["difficulty"] in {"하", "중", "상"}
        assert set(q["law_refs"]) <= law_ids
    assert {q["subject"] for q in questions} == set(SUBJECTS)


def test_filter_questions():
    subject = SUBJECTS[0]
    result = qb.filter_questions(subjects=[subject], difficulties=["하"])
    assert result and all(q["subject"] == subject and q["difficulty"] == "하" for q in result)
    assert len(qb.filter_questions()) == len(qb.load_questions())


# ---------------------------------------------------------------- 채점

def test_summarize_pass_and_fail():
    questions = [q for q in qb.load_questions() if q["subject"] in SUBJECTS[:2]]
    all_correct = {q["id"]: q["answer"] for q in questions}
    result = grader.summarize(questions, all_correct)
    assert result.average == 100 and result.passed

    # 1과목만 전부 틀리면 평균은 50점이고 과락으로 불합격
    answers = {q["id"]: (None if q["subject"] == SUBJECTS[0] else q["answer"]) for q in questions}
    result = grader.summarize(questions, answers)
    assert result.subjects[0].score == 0
    assert not result.passed
    assert any("과락" in r for r in result.fail_reasons)


